  <span class="wlabel__badge">Current</span>
  </span>
          <span class="wlabel__val">230<i>kPa</i>
  </span>
          
          
        </button>
              
        <button class="wlabel wlabel--fr" style="--c:var(--divider-color)" data-entity="sensor.mini_tyre_row1_right" title="Front right">
          <span class="wlabel__pos">
  <b>FR</b>
  <span class="wlabel__badge">Current</span>
  </span>
          <span class="wlabel__val">230<i>kPa</i>
  </span>
          
          
        </button>
              
        <button class="wlabel wlabel--rl" style="--c:var(--divider-color)" data-entity="sensor.mini_tyre_row2_left" title="Rear left">
          <span class="wlabel__pos">
  <b>RL</b>
  <span class="wlabel__badge">Current</span>
  </span>
          <span class="wlabel__val">230<i>kPa</i>
  </span>
          
          
        </button>
              
        <button class="wlabel wlabel--rr" style="--c:var(--divider-color)" data-entity="sensor.mini_tyre_row2_right" title="Rear right">
          <span class="wlabel__pos">
  <b>RR</b>
  <span class="wlabel__badge">Current</span>
  </span>
          <span class="wlabel__val">230<i>kPa</i>
  </span>
          
          
        </button>
            </div>
          </div>
        </ha-card>
  '''
