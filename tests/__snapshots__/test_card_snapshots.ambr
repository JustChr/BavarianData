# serializer version: 1
# name: test_the_card_renders_what_it_rendered_before[charging-i5]
  '''
  <ha-card>
          <div class="chead">
            <ha-icon icon="mdi:ev-station">
  </ha-icon>
            <div class="chead__text">
              <span class="chead__title">Charging history</span>
              <span class="chead__sub">Car</span>
            </div>
            
        <div class="xbar">
          <button class="xbtn" data-export="csv" data-kind="charging"
                  title="Download this month as a spreadsheet">
            <ha-icon icon="mdi:file-delimited-outline">
  </ha-icon>CSV
          </button>
          <button class="xbtn" data-export="html" data-kind="both"
                  title="Open a printable month report (print it to get a PDF)">
            <ha-icon icon="mdi:file-document-outline">
  </ha-icon>Report
          </button>
        </div>
          </div>
          
        <div class="mnav">
          <button class="mnav__btn" data-month-kind="charging" data-month-step="-1"
                  title="Previous month" aria-label="Previous month">
            <ha-icon icon="mdi:chevron-left">
  </ha-icon>
          </button>
          <span class="mnav__label">September 2026</span>
          <button class="mnav__btn" data-month-kind="charging" data-month-step="1"
                  title="Next month" aria-label="Next month"
                  disabled>
            <ha-icon icon="mdi:chevron-right">
  </ha-icon>
          </button>
        </div>
          
          <div class="empty">Loading charging history…</div>
        </ha-card>
  '''
