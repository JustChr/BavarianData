# name: test_the_card_renders_what_it_rendered_before[overview-i5]
  '''
  <ha-card>
          <div class="hero hero--empty">
            <ha-icon class="hero__placeholder" icon="mdi:car-electric">
  </ha-icon>
            <div class="hero__scrim">
  </div>
            <div class="hero__top">
              <div class="hero__name" title="Car">Car</div>
              <div class="pill" title="Last update">
  <span class="dot dot--stale">
  </span>21 h ago</div>
            </div>
            
          </div>
  
          <div class="band">
            <button class="gauge" data-entity="sensor.i5_soc" aria-label="charge">
              <div class="gauge__ring" style="--pct:72;--ring:var(--bmw-high)">
                <div class="gauge__hole">
                  <span class="gauge__val">72<i>%</i>
  </span>
                  <span class="gauge__cap">charge</span>
                </div>
              </div>
              
            </button>
  
            <div class="lead">
              
              <button class="lead__row" data-entity="sensor.i5_range">
                <ha-icon icon="mdi:map-marker-distance">
  </ha-icon>
                <span class="lead__val">379 km</span>
                <span class="lead__lbl">remaining range</span>
              </button>
              <button class="lead__row" data-entity="sensor.i5_charging">
                <ha-icon icon="mdi:ev-station">
  </ha-icon>
                <span class="lead__val">nocharging</span>
                <span class="lead__lbl">charging status</span>
              </button>
            </div>
          </div>
  
          <div class="grid">
                  
                    <button class="cell" data-entity="sensor.i5_target">
                      <ha-icon icon="mdi:target">
  </ha-icon>
                      <div class="cell__body">
                        <span class="cell__val">0 %</span>
                        <span class="cell__lbl">Target</span>
                      </div>
                    </button>
                    <button class="cell" data-entity="sensor.i5_odometer">
                      <ha-icon icon="mdi:counter">
  </ha-icon>
                      <div class="cell__body">
                        <span class="cell__val">41234 km</span>
                        <span class="cell__lbl">Odometer</span>
                      </div>
                    </button>
                </div>
        </ha-card>
  '''
