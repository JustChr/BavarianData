# name: test_plugged_in_and_waiting_is_a_situation
  '''
      0.0  capacity                 est=     - rate=    - charging=off open=n sessions=0
      1.0  wait 1                   est=     - rate=    - charging=off open=n sessions=0
      1.0  send soc=50,target=80,plug=CONNECTED,status=NOCHARGING est= 50.00 rate=    - charging=off open=n sessions=0 situation
     20.0  wait 20                  est= 50.00 rate=    - charging=off open=n sessions=0
     20.0  send status=CHARGINGACTIVE,power=11000 est= 50.00 rate=14.67 charging=on  open=y sessions=0 charging_started,situation
  '''
# ---
# name: test_preconditioning_starts_and_finishes
  '''
      0.0  capacity                 est=     - rate=    - charging=off open=n sessions=0
      1.0  wait 1                   est=     - rate=    - charging=off open=n sessions=0
      1.0  send                     est=     - rate=    - charging=off open=n sessions=0
      5.0  wait 5                   est=     - rate=    - charging=off open=n sessions=0
      5.0  send soc=70              est= 70.00 rate=    - charging=off open=n sessions=0 preconditioning
     25.0  wait 25                  est= 70.00 rate=    - charging=off open=n sessions=0
     25.0  send                     est= 70.00 rate=    - charging=off open=n sessions=0 preconditioning
  '''
