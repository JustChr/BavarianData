# serializer version: 1
# name: test_the_default_and_a_custom_grid_render_as_before[custom]
  '''
  <ha-card>
          <div class="hero hero--empty">
            <ha-icon class="hero__placeholder" icon="mdi:car">
  </ha-icon>
            <div class="hero__scrim">
  </div>
            <div class="hero__top">
              <div class="hero__name" title="Car">Car</div>
              <div class="pill" title="Last update">
  <span class="dot dot--stale">
  </span>21 h ago</div>
            </div>
            
          </div>
  
          <button class="verdict" data-entity="sensor.car_lock">
            <span class="verdict__t verdict__t--ok">Ready to go</span>
            <span class="verdict__s">home</span>
          </button>
  
          <div class="meter">
            <div class="meter__row">
              <button class="meter__main" data-entity="sensor.m2_remaining_fuel">
                <span class="meter__big">38<i>L</i>
  </span>
                <span class="meter__cap">fuel</span>
              </button>
              <button class="meter__side" data-entity="sensor.m2_range">
                <span class="meter__mid">412 km</span>
                <span class="meter__cap">remaining range</span>
              </button>
            </div>
            
            
            
          </div>
  
          <div class="grid">
                  
                    <button class="cell" data-entity="sensor.car_tyre_row1_left_pressure">
                      <ha-icon icon="mdi:tire" style="color:var(--bmw-high)">
  </ha-icon>
                      <div class="cell__body">
                        <span class="cell__val">250 – 260 kPa</span>
                        <span class="cell__lbl">Tires</span>
                      </div>
                    </button>
                    <button class="cell" data-entity="sensor.car_lock">
                      <ha-icon icon="mdi:lock" style="color:var(--bmw-high)">
  </ha-icon>
                      <div class="cell__body">
                        <span class="cell__val">Locked</span>
                        <span class="cell__lbl">Lock</span>
                      </div>
                    </button>
                    <button class="cell" data-entity="sensor.car_coolant">
                      <ha-icon icon="mdi:thermometer">
  </ha-icon>
                      <div class="cell__body">
                        <span class="cell__val">88 °C</span>
                        <span class="cell__lbl">BMW Coolant temperature</span>
                      </div>
                    </button>
                </div>
        </ha-card>
  '''
