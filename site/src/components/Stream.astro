---
// The MQTT stream made visible: real descriptor/value pairs from the demo car,
// drifting past the way they arrive. Static (and scrollable) with reduced motion.
import demo from "../demo/i5.json";
import { url, localized, type Lang } from "../lib/site";

interface Props {
  lang: Lang;
  title: string;
  body: string;
  link: string;
}
const { lang, title, body, link } = Astro.props;
const numberFormat = new Intl.NumberFormat(lang === "de" ? "de-DE" : "en-US", { maximumFractionDigits: 1 });
const rows = Object.values(demo.states as Record<string, { state: string; attributes: Record<string, any> }>)
  .filter((s) => String(s.attributes.descriptor || "").startsWith("vehicle.") && !["unknown", "unavailable", ""].includes(s.state))
  .map((s) => {
    const n = Number(s.state);
    const unit = s.attributes.unit_of_measurement;
    const value = Number.isFinite(n) && s.state !== "" ? numberFormat.format(n) : s.state.toUpperCase();
    return { descriptor: s.attributes.descriptor as string, value: unit ? `${value} ${unit}` : value };
  });
const half = Math.ceil(rows.length / 2);
const lines = [rows.slice(0, half), rows.slice(half)];
---
<section class="stream">
  <div class="wrap stream__head">
    <h2>{title}</h2>
    <p>{body} <a href={url(localized("data", lang))}>{link}</a></p>
  </div>
  <div class="stream__band" aria-hidden="true">
    {lines.map((line, i) => (
      <div class:list={["stream__line", { "stream__line--rev": i === 1 }]}>
        {[0, 1].map(() => (
          <div class="stream__run">
            {line.map((r) => (
              <span class="stream__item"><code>{r.descriptor}</code><b>{r.value}</b></span>
            ))}
          </div>
        ))}
      </div>
    ))}
  </div>
</section>

<style>
  .stream {
    margin-top: clamp(56px, 8vw, 96px);
  }
  .stream__head {
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(0, 1.4fr);
    gap: 16px 48px;
    align-items: end;
  }
  .stream__head h2 {
    font-size: var(--step-3);
  }
  .stream__head p {
    margin: 0;
    color: var(--slate);
    max-width: 60ch;
  }
  .stream__band {
    margin-top: 36px;
    display: grid;
    gap: 12px;
    overflow: hidden;
    mask-image: linear-gradient(90deg, transparent, #000 8%, #000 92%, transparent);
  }
  .stream__line {
    display: flex;
    width: max-content;
    animation: drift 160s linear infinite;
  }
  .stream__line--rev {
    animation-direction: reverse;
    animation-duration: 190s;
  }
  .stream__band:hover .stream__line {
    animation-play-state: paused;
  }
  .stream__run {
    display: flex;
    gap: 12px;
    padding-right: 12px;
  }
  .stream__item {
    display: inline-flex;
    align-items: baseline;
    gap: 12px;
    padding: 9px 14px;
    border-radius: 10px;
    background: var(--surface);
    border: 1px solid var(--line);
    white-space: nowrap;
  }
  .stream__item code {
    font-family: var(--mono);
    font-size: 0.8rem;
    color: var(--slate);
  }
  .stream__item b {
    font-size: 0.9rem;
    font-weight: 650;
    color: var(--ink);
  }
  @keyframes drift {
    to {
      transform: translateX(-50%);
    }
  }
  @media (prefers-reduced-motion: reduce) {
    .stream__band {
      overflow-x: auto;
      mask-image: none;
    }
    .stream__line {
      animation: none;
    }
    .stream__run + .stream__run {
      display: none;
    }
  }
  @media (max-width: 800px) {
    .stream__head {
      grid-template-columns: minmax(0, 1fr);
    }
  }
</style>
