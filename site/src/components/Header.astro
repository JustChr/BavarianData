---
import Mark from "./Mark.astro";
import { ui } from "../i18n";
import { url, localized, REPO, STARS, type Lang } from "../lib/site";

interface Props {
  lang: Lang;
  /** Language-neutral path of this page, e.g. `docs/trips`. */
  path: string;
  /** Whether this page exists in the other language. */
  alternate: boolean;
}
const { lang, path, alternate } = Astro.props;
const t = ui[lang];
const stars = STARS === null ? null : STARS.toLocaleString(lang);
const other: Lang = lang === "en" ? "de" : "en";
const otherHref = url(localized(alternate ? path : "", other));
const home = url(localized("", lang));
const current = Astro.url.pathname;
const links = [
  { href: url(localized("docs", lang)), label: t.nav.docs, match: "/docs/" },
  { href: url(localized("data", lang)), label: t.nav.data, match: "/data/" },
  { href: url(localized("docs/coming-from-bimmer-connected", lang)), label: t.nav.switch, match: "/coming-from-bimmer-connected/" },
];
const isCurrent = (match: string) =>
  current.includes(match) && (match !== "/docs/" || !current.includes("/coming-from-bimmer-connected/"));
---
<header class="top">
  <div class="wrap top__row">
    <a class="brand" href={home} aria-label="BavarianData">
      <Mark size={30} />
      <span class="brand__name">BavarianData</span>
    </a>

    <nav class="top__nav" aria-label={t.menu}>
      {links.map((l) => (
        <a href={l.href} aria-current={isCurrent(l.match) ? "page" : undefined}>{l.label}</a>
      ))}
    </nav>

    <div class="top__tools">
      <button class="tool" type="button" data-search-open aria-label={t.search}>
        <svg viewBox="0 0 24 24" aria-hidden="true"><circle cx="11" cy="11" r="6.5" /><path d="m16 16 4.5 4.5" /></svg>
        <span class="tool__label">{t.search}</span>
        <kbd class="tool__kbd">/</kbd>
      </button>
      <a class="tool tool--lang" href={otherHref} hreflang={other} lang={other} aria-label={t.languageLabel}>
        {other.toUpperCase()}
      </a>
      <button class="tool" type="button" data-theme-toggle aria-label={t.theme}>
        <svg class="i-sun" viewBox="0 0 24 24" aria-hidden="true"><circle cx="12" cy="12" r="4.2" /><path d="M12 2.5v2.2M12 19.3v2.2M4.9 4.9l1.6 1.6M17.5 17.5l1.6 1.6M2.5 12h2.2M19.3 12h2.2M4.9 19.1l1.6-1.6M17.5 6.5l1.6-1.6" /></svg>
        <svg class="i-moon" viewBox="0 0 24 24" aria-hidden="true"><path d="M19.5 14.5A8 8 0 0 1 9.5 4.5a8 8 0 1 0 10 10Z" /></svg>
      </button>
      <a class="tool tool--gh" href={REPO} aria-label={t.starLabel}>
        <svg viewBox="0 0 24 24" aria-hidden="true"><path d="m12 3.6 2.6 5.3 5.8.8-4.2 4.1 1 5.8-5.2-2.7-5.2 2.7 1-5.8L3.6 9.7l5.8-.8L12 3.6Z" /></svg>
        <span class="tool__star">{t.star}</span>
        <span class="tool__count" data-stars hidden={!stars}>{stars}</span>
      </a>
      <a class="btn btn--primary top__cta" href={url(localized("docs/install", lang))}>{t.nav.install}</a>
      <details class="top__menu">
        <summary aria-label={t.menu}>
          <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M4 7h16M4 12h16M4 17h16" /></svg>
        </summary>
        <nav class="top__sheet" aria-label={t.menu}>
          {links.map((l) => <a href={l.href}>{l.label}</a>)}
          <a href={url(localized("docs/install", lang))}>{t.nav.install}</a>
          <a href={REPO}>★ {t.starLabel} <span data-stars data-stars-wrap hidden={!stars}>({stars})</span></a>
        </nav>
      </details>
    </div>
  </div>
</header>

<dialog class="search" data-search aria-label={t.search}>
  <div class="search__box">
    <div data-search-ui data-placeholder={t.searchPlaceholder}></div>
    <form method="dialog"><button class="search__close" aria-label="Close">Esc</button></form>
  </div>
</dialog>

<script>
  // Star count: the build's number is the first paint (and the no-JS value);
  // the browser then asks GitHub for the current one, at most once an hour.
  const starEls = document.querySelectorAll<HTMLElement>("[data-stars]");
  const showStars = (n: number) =>
    starEls.forEach((el) => {
      const v = n.toLocaleString(document.documentElement.lang || "en");
      el.textContent = el.hasAttribute("data-stars-wrap") ? `(${v})` : v;
      el.hidden = false;
    });
  // Not on the critical path: the count is decoration, so it waits until the
  // page has loaded and the browser is idle.
  const starsWhenIdle = (run: () => void) => {
    const idle = () => ("requestIdleCallback" in window ? requestIdleCallback(run) : setTimeout(run, 200));
    if (document.readyState === "complete") idle();
    else addEventListener("load", idle, { once: true });
  };
  starsWhenIdle(async () => {
    const KEY = "stars";
    try {
      const cached = JSON.parse(localStorage.getItem(KEY) || "null");
      if (cached && Date.now() - cached.at < 3600_000) return showStars(cached.n);
    } catch {}
    try {
      const res = await fetch("https://api.github.com/repos/JustChr/BavarianData");
      const n = res.ok ? (await res.json()).stargazers_count : null;
      if (typeof n !== "number") return;
      showStars(n);
      try {
        localStorage.setItem(KEY, JSON.stringify({ n, at: Date.now() }));
      } catch {}
    } catch {}
  });

  // Theme: explicit choice wins over the OS; stored per viewer only.
  const root = document.documentElement;
  document.querySelector("[data-theme-toggle]")?.addEventListener("click", () => {
    const dark =
      root.dataset.theme === "dark" ||
      (!root.dataset.theme && matchMedia("(prefers-color-scheme: dark)").matches);
    root.dataset.theme = dark ? "light" : "dark";
    try {
      localStorage.setItem("theme", root.dataset.theme);
    } catch {}
  });

  // Search: Pagefind's UI, loaded the first time someone asks for it.
  const dialog = document.querySelector<HTMLDialogElement>("[data-search]");
  let loaded = false;
  async function openSearch() {
    if (!dialog) return;
    dialog.showModal();
    if (loaded) {
      dialog.querySelector<HTMLInputElement>("input")?.focus();
      return;
    }
    loaded = true;
    const base = import.meta.env.BASE_URL.replace(/\/$/, "");
    const css = document.createElement("link");
    css.rel = "stylesheet";
    css.href = `${base}/pagefind/pagefind-ui.css`;
    document.head.append(css);
    try {
      // A classic script: Pagefind's UI is not a module, and it is built with
      // the pages, so it only exists on the published site.
      await new Promise<void>((resolve, reject) => {
        const script = document.createElement("script");
        script.src = `${base}/pagefind/pagefind-ui.js`;
        script.onload = () => resolve();
        script.onerror = () => reject(new Error("search index missing"));
        document.head.append(script);
      });
      const host = dialog.querySelector<HTMLElement>("[data-search-ui]")!;
      // @ts-ignore
      new window.PagefindUI({
        element: host,
        bundlePath: `${base}/pagefind/`,
        showSubResults: true,
        showImages: false,
        translations: { placeholder: host.dataset.placeholder },
      });
      dialog.querySelector<HTMLInputElement>("input")?.focus();
    } catch {
      dialog.querySelector("[data-search-ui]")!.textContent =
        "Search is available on the published site (it is built with the pages).";
    }
  }
  document.querySelectorAll("[data-search-open]").forEach((b) => b.addEventListener("click", openSearch));
  document.addEventListener("keydown", (e) => {
    const target = e.target as HTMLElement;
    if (e.key === "/" && !/INPUT|TEXTAREA|SELECT/.test(target.tagName) && !target.isContentEditable) {
      e.preventDefault();
      openSearch();
    }
  });
  dialog?.addEventListener("click", (e) => {
    if (e.target === dialog) dialog.close();
  });
</script>

<style>
  .top {
    position: sticky;
    top: 0;
    z-index: 50;
    background: color-mix(in oklab, var(--frost) 86%, transparent);
    backdrop-filter: saturate(1.4) blur(12px);
    border-bottom: 1px solid color-mix(in oklab, var(--line) 70%, transparent);
  }
  .top__row {
    display: flex;
    align-items: center;
    gap: 20px;
    height: 64px;
  }
  .brand {
    display: inline-flex;
    align-items: center;
    gap: 10px;
    color: var(--ink);
    text-decoration: none;
    font-weight: 700;
    font-stretch: 116%;
    font-size: 1.1rem;
    letter-spacing: -0.01em;
  }
  .top__nav {
    display: flex;
    gap: 4px;
    margin-left: 12px;
  }
  .top__nav a {
    color: var(--slate);
    text-decoration: none;
    font-weight: 550;
    font-size: 0.95rem;
    padding: 8px 12px;
    border-radius: 999px;
  }
  .top__nav a:hover {
    color: var(--ink);
    background: var(--surface-2);
  }
  .top__nav a[aria-current="page"] {
    color: var(--ink);
    background: var(--surface);
    box-shadow: inset 0 0 0 1px var(--line);
  }
  .top__tools {
    margin-left: auto;
    display: flex;
    align-items: center;
    gap: 6px;
  }
  .tool {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    height: 38px;
    min-width: 38px;
    justify-content: center;
    padding: 0 10px;
    border: 1px solid var(--line);
    border-radius: 999px;
    background: var(--surface);
    color: var(--ink);
    font: inherit;
    font-size: 0.9rem;
    font-weight: 600;
    text-decoration: none;
    cursor: pointer;
  }
  .tool:hover {
    border-color: var(--brand);
  }
  .tool svg {
    width: 18px;
    height: 18px;
    fill: none;
    stroke: currentColor;
    stroke-width: 1.8;
    stroke-linecap: round;
  }
  .tool__label {
    color: var(--slate);
    font-weight: 500;
    padding-right: 18px;
  }
  .tool__star {
    padding-right: 4px;
  }
  .tool__count {
    margin-left: -2px;
    padding-left: 8px;
    border-left: 1px solid var(--line);
    color: var(--slate);
    font-variant-numeric: tabular-nums;
  }
  .tool--gh:hover svg {
    fill: #f2b01e;
    stroke: #f2b01e;
  }
  .tool__kbd {
    font-size: 0.75rem;
    color: var(--slate);
    border: 1px solid var(--line);
    border-radius: 4px;
    padding: 0 5px;
  }
  .i-moon {
    display: none;
  }
  :global(:root[data-theme="dark"]) .i-sun {
    display: none;
  }
  :global(:root[data-theme="dark"]) .i-moon {
    display: block;
  }
  @media (prefers-color-scheme: dark) {
    :global(:root:not([data-theme="light"])) .i-sun {
      display: none;
    }
    :global(:root:not([data-theme="light"])) .i-moon {
      display: block;
    }
  }
  .top__cta {
    padding: 0.5em 1.05em;
    font-size: 0.93rem;
    margin-left: 4px;
  }
  .top__menu {
    display: none;
    position: relative;
  }
  .top__menu summary {
    list-style: none;
    cursor: pointer;
    display: grid;
    place-items: center;
    width: 38px;
    height: 38px;
    border-radius: 999px;
    border: 1px solid var(--line);
    background: var(--surface);
  }
  .top__menu summary::-webkit-details-marker {
    display: none;
  }
  .top__menu summary svg {
    width: 20px;
    height: 20px;
    stroke: var(--ink);
    stroke-width: 1.8;
    stroke-linecap: round;
  }
  .top__sheet {
    position: absolute;
    right: 0;
    top: 46px;
    min-width: 250px;
    display: grid;
    padding: 8px;
    background: var(--surface);
    border: 1px solid var(--line);
    border-radius: var(--radius-m);
    box-shadow: var(--shadow);
  }
  .top__sheet a {
    padding: 10px 12px;
    border-radius: 8px;
    color: var(--ink);
    text-decoration: none;
    font-weight: 550;
  }
  .top__sheet a:hover {
    background: var(--surface-2);
  }
  @media (max-width: 1080px) {
    .tool__label,
    .tool__star,
    .tool__count,
    .tool__kbd {
      display: none;
    }
    .tool {
      padding: 0;
    }
  }
  @media (max-width: 900px) {
    .top__nav,
    .top__cta,
    .tool--gh {
      display: none;
    }
    .top__menu {
      display: block;
    }
  }
  @media (max-width: 380px) {
    .brand__name {
      display: none;
    }
  }

  .search {
    width: min(720px, 94vw);
    max-height: 80vh;
    border: 1px solid var(--line);
    border-radius: var(--radius-l);
    background: var(--surface);
    color: var(--ink);
    padding: 20px;
    margin-top: 10vh;
    box-shadow: var(--shadow);
  }
  .search::backdrop {
    background: rgb(4 10 26 / 55%);
    backdrop-filter: blur(2px);
  }
  .search__box {
    display: grid;
    grid-template-columns: 1fr auto;
    gap: 10px;
    align-items: start;
  }
  .search__close {
    font: inherit;
    font-size: 0.8rem;
    border: 1px solid var(--line);
    background: var(--surface-2);
    color: var(--slate);
    border-radius: 6px;
    padding: 12px 10px;
    cursor: pointer;
  }
  .search :global(.pagefind-ui) {
    --pagefind-ui-scale: 0.86;
    --pagefind-ui-primary: var(--brand);
    --pagefind-ui-text: var(--ink);
    --pagefind-ui-background: var(--surface);
    --pagefind-ui-border: var(--line);
    --pagefind-ui-tag: var(--surface-2);
    --pagefind-ui-font: var(--font);
    --pagefind-ui-border-radius: 10px;
  }
</style>
