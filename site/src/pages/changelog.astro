---
// What's new: CHANGELOG.md's stable releases, rendered. English only, like the
// file itself; the German site links here too.
import { getEntry, render } from "astro:content";
import Base from "../layouts/Base.astro";
import { ui } from "../i18n";
import { url, absolute, lastModified, RELEASE, REPO } from "../lib/site";
import releases from "../generated/releases.json";

const entry = (await getEntry("changelog", "changelog"))!;
const { Content } = await render(entry);
const t = ui.en;
const title = "BavarianData changelog: what's new in every release";
const description = `Every stable BavarianData release since ${releases.at(-1)?.version}, newest first: what was added, changed and fixed in the Home Assistant integration for BMW CarData. The latest is ${RELEASE.version}.`;
const modified = lastModified("CHANGELOG.md");
const jsonLd = [
  {
    "@context": "https://schema.org",
    "@type": "TechArticle",
    headline: title,
    description,
    inLanguage: "en",
    url: absolute("changelog"),
    ...(modified ? { dateModified: modified } : {}),
    isPartOf: { "@type": "WebSite", name: "BavarianData", url: absolute("") },
    author: { "@type": "Person", name: "JustChr", url: "https://github.com/JustChr" },
  },
];
---
<Base lang="en" title={title} description={description} path="changelog" alternate={false} jsonLd={jsonLd} ogType="article" modified={modified}>
  <div class="wrap log">
    <main id="main" class="log__main">
      <article data-pagefind-body>
        <h1>What's new</h1>
        <p class="log__lead">
          Every stable release, newest first. Pre-releases are folded into the stable that follows them.
          The same text is on each <a href={`${REPO}/releases`}>GitHub release</a>.
        </p>
        <nav class="log__jump" aria-label="Releases">
          {releases.map((r) => <a href={`#v${r.version}`}>{r.version}</a>)}
        </nav>
        <div class="prose">
          <Content />
        </div>
      </article>
      <p class="log__meta">
        <a href={`${REPO}/blob/main/CHANGELOG.md`}>{t.edit.replace("this page", "the changelog")}</a>
      </p>
    </main>
  </div>
</Base>

<style>
  .log {
    padding-top: 36px;
  }
  .log__main {
    max-width: var(--measure);
    margin-inline: auto;
    min-width: 0;
  }
  .log__main h1 {
    font-size: var(--step-3);
    margin-bottom: 16px;
  }
  .log__lead {
    color: var(--slate);
  }
  .log__jump {
    display: flex;
    flex-wrap: wrap;
    gap: 6px;
    margin: 20px 0 8px;
  }
  .log__jump a {
    padding: 3px 10px;
    border: 1px solid var(--line);
    border-radius: 999px;
    background: var(--surface);
    color: var(--ink-soft);
    font-size: 0.85rem;
    text-decoration: none;
  }
  .log__jump a:hover {
    border-color: var(--brand);
    color: var(--brand);
  }
  .log :global(.prose h2) {
    margin-top: 56px;
    padding-top: 24px;
    border-top: 1px solid var(--line);
  }
  .log :global(.prose h2 small) {
    margin-left: 10px;
    color: var(--slate);
    font-size: 0.62em;
    font-weight: 500;
    font-stretch: 100%;
  }
  .log :global(.prose h3) {
    font-size: 1rem;
    color: var(--slate);
    text-transform: uppercase;
    letter-spacing: 0.04em;
  }
  .log__meta {
    margin-top: 40px;
    font-size: 0.88rem;
    color: var(--slate);
  }
</style>
